# USVA Membership Server Environment Variables

PORT=5000

# MongoDB URI (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb://localhost:27017/usva-membership

# JWT secret key for token signing
JWT_SECRET=super_secret_jwt_key_change_me_in_production

# Razorpay credentials (UPI payment)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Cloudinary credentials for image storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# SMTP Email Configuration (Nodemailer)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password
EMAIL_FROM=USVA Alumni Association <your_email@gmail.com>

# Frontend URL (CORS protection)
FRONTEND_URL=http://localhost:5173
